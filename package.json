{
  "name": "web98",
  "productName": "Web98",
  "version": "0.1.0",
  "description": "A real web browser with an authentic Windows 98 / Internet Explorer 5 interface",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "electron test/unit/runner.js",
    "test:e2e": "node test/e2e/smoke.js",
    "test:restore": "node test/e2e/restore.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "bench": "node test/bench/startup.js",
    "bench:memory": "node test/bench/memory.js",
    "bench:cef": "node test/bench/startup_cef.js",
    "dist": "electron-builder --win nsis portable",
    "dist:win-arm64": "electron-builder --win nsis portable --arm64",
    "dist:linux": "electron-builder --linux dir",
    "dist:linux-arm64": "electron-builder --linux dir --arm64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "puppeteer-core": "^25.13.0"
  },
  "build": {
    "appId": "com.web98.browser",
    "productName": "Web98",
    "copyright": "Copyright © 2026 Web98",
    "npmRebuild": false,
    "artifactName": "${productName} ${version} ${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "css/ie5-shell.css",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "Web98 <web98@localhost>"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}",
      "license": "LICENSE.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Web98"
    }
  }
}
